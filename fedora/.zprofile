# ------- CONFIG ------- #

# config: linuxbrew
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# -------- PATH -------- #

# path: opt-local-bin
export PATH="$PATH:/opt/local/bin"

# path: opt-local-sbin
export PATH="$PATH:/opt/local/sbin"
